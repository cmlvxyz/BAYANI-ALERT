# =============================================
# Bayani backend — Turso (hosted libSQL) setup
# =============================================
# To use Turso:
#   1) Create a database at https://turso.tech  (e.g. "bayani-alert")
#   2) Copy the database URL (looks like: libsql://bayani-alert-YOURDB.turso.io)
#   3) Create a token in the dashboard, then copy it
#   4) Uncomment these two lines and paste your values, then save.
#
# DATABASE_URL=libsql://bayani-alert-YOURDB.turso.io
# TURSO_AUTH_TOKEN=your-turso-token-here
#
# Leave both commented to use the local file database (server/data/incidents.db).

# =============================================
# Emergency SMS (Semaphore — https://semaphore.co)
# =============================================
# 1) Register free at semaphore.co and load a little credit.
# 2) Generate an API key under "Account > API".
# 3) (Optional) Register a Sender Name under "Account > Sender Names".
# 4) Set SMS_MODE=live to actually deliver texts to your contacts.
#
# SMS_MODE=simulation (default) records what *would* be sent without texting —
# safe for demos/testing. SMS_MODE=live sends real SMS via Semaphore.
#
SMS_MODE=simulation
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=BAYANI
SMS_PUBLIC_URL=http://localhost:4001
#
# Provider is pluggable; leave as semaphore unless another gateway is added.
# SMS_PROVIDER=semaphore

# =============================================
# Google Maps JavaScript API (frontend — Vite)
# =============================================
# 1) Create a key at https://console.cloud.google.com/google/maps-apis
# 2) Enable the "Maps JavaScript API" (covers StreetViewService / StreetViewPanorama).
# 3) Restrict the key to HTTP referrers (http://localhost:4000/*, http://localhost:4001/*).
# 4) Paste the key below (leave blank to keep the keyless iframe fallback).
#
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# =============================================
# Bayani Bridge — frontend base URL (Vite)
# =============================================
# Leave VITE_BRIDGE_URL commented out: the frontend then defaults to the SAME
# host as the page (hostname:8000), so the app works from other PCs on the
# LAN without any config. Only set this if the backend runs on a different
# machine than the frontend.
#
# VITE_BRIDGE_URL=http://localhost:8000

# =============================================
# Wearable SOS devices (backend — server/devices.mjs)
# =============================================
# A physical band (ESP32-S3 + SIMCom A7670E) raises an emergency by posting to
# POST /device/sos with its shared secret; the backend stores the incident and
# pushes it to this console and to the owning citizen's app. An unregistered
# device is rejected (401) — there is no open door.
#
# Device id "BA-001" maps to the prefix "DEVICE_BA_001_".
# Only _KEY is required; a band without _OWNER is refused (403) because an
# emergency must be filed under a real, active citizen account.
#
# Generate a key with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# DEVICE_BA_001_KEY=long-random-string-known-only-to-this-server-and-the-device
# DEVICE_BA_001_OWNER=dela
# DEVICE_BA_001_LABEL=BA-001 Thigh Band
# DEVICE_BA_001_TYPE=BAYANI-WEARABLE
#
# Many devices, or keeping the registry out of .env? Use a JSON array instead
# (same fields, case-insensitive keys). Where both define a device, JSON wins.
# Keys are never logged and never sent to a browser.
#
# DEVICE_REGISTRY_JSON=[{"deviceId":"BA-001","key":"...","ownerUsername":"dela","label":"BA-001 Thigh Band"}]
#
# Full device reference: docs/HARDWARE_INTEGRATION.md

# =============================================
# Privacy & security tuning (backend — server/index.mjs)
# =============================================
# How many days a closed incident is kept before the retention job purges it.
# POST /retention/run (admin-only) executes the purge manually.
#
RETENTION_DAYS=90

# Comma/space-separated list of allowed browser origins for the API (CORS).
# Keep these limited to the two local apps.
#
CORS_ORIGINS=http://localhost:4000 http://localhost:4001 http://127.0.0.1:4000 http://127.0.0.1:4001

# Where the citizen apps can read the LGU contact points for privacy questions.
# Placeholders only — set these once the LGU assigns a Data Protection Officer.
#
# VITE_PRIVACY_OFFICER=LGU Data Protection Officer
# VITE_PRIVACY_CONTACT=privacy ops office at City Hall Balanga